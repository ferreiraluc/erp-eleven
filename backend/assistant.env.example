# Append these values to backend/.env for local use, or set in BOTH API and worker.
# Never commit live credentials. Start disabled until migrations and identities are ready.
ASSISTANT_ENABLED=false
ASSISTANT_TELEGRAM_ENABLED=true
ASSISTANT_WHATSAPP_ENABLED=false
# Pilot on an existing always-on API; leave false when using a separate worker.
ASSISTANT_EMBEDDED_WORKER=false
ASSISTANT_DAILY_MESSAGES=100
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+5511999999999
TWILIO_WEBHOOK_URL=https://YOUR-BACKEND/api/assistant/webhooks/twilio
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
