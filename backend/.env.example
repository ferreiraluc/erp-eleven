# Local/development reference. Never put live secrets in a tracked file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eleven
SECRET_KEY=replace-with-a-random-local-secret
ALGORITHM=HS256
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# Optional providers: tracking and inventory OCR
WONCA_API_KEY=
ANTHROPIC_API_KEY=
VISION_PROVIDER=auto
DEEPSEEK_VISION_MODEL=deepseek-flash

# Assistant: disabled until database, identities and webhooks are ready
ASSISTANT_ENABLED=false
ASSISTANT_TELEGRAM_ENABLED=true
ASSISTANT_WHATSAPP_ENABLED=false
ASSISTANT_EMBEDDED_WORKER=false
ASSISTANT_DAILY_MESSAGES=100
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=

# Tokens differ between Sandbox and production
SUPERFRETE_TOKEN=
SUPERFRETE_CONTACT_EMAIL=
SUPERFRETE_SANDBOX=true
SUPERFRETE_WEBHOOK_SECRET=
