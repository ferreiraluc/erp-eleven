# Local/development reference. Never put live secrets in a tracked file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eleven
SECRET_KEY=replace-with-a-random-local-secret
ALGORITHM=HS256
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
# Render sets RENDER=true; outside Render use APP_ENV=production.
APP_ENV=development
# Pool per API process (keep a single Uvicorn process in the current deployment).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
# Some provider flows still hold transactions; enable only after separating them.
DB_IDLE_TRANSACTION_TIMEOUT_MS=0

# Optional providers: tracking and inventory OCR
WONCA_API_KEY=
ANTHROPIC_API_KEY=
VISION_PROVIDER=auto
DEEPSEEK_VISION_MODEL=deepseek-flash

# Assistant: disabled until database, identities and webhooks are ready
ASSISTANT_ENABLED=false
ASSISTANT_TELEGRAM_ENABLED=true
ASSISTANT_WHATSAPP_ENABLED=false
ASSISTANT_EMBEDDED_WORKER=false
ASSISTANT_DAILY_MESSAGES=100
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=

# Tokens differ between Sandbox and production
SUPERFRETE_TOKEN=
SUPERFRETE_CONTACT_EMAIL=
SUPERFRETE_SANDBOX=true
SUPERFRETE_WEBHOOK_SECRET=

# Cadastro por foto: edição opcional, uma imagem em qualidade low.
# gpt-image-1-mini: retirada anunciada em 2026-12-01; reavaliar custo antes de trocar.
OPENAI_API_KEY=
PRODUCT_PHOTO_IMAGE_MODEL=gpt-image-1-mini
